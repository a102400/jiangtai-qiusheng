# 环境变量配置示例
# 用法：复制此文件为 .env，然后填入你自己的 Key
# 注意：此文件仅存在于服务端，永远不要提交到 GitHub，也不要写进任何前端文件

# 必填：大模型 API Key（以 DeepSeek 为例）
AI_API_KEY=sk-在这里填你的密钥

# 选填：接口地址（OpenAI 兼容格式，可换任意兼容网关）
# DeepSeek:  https://api.deepseek.com
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
AI_BASE_URL=https://api.deepseek.com

# 选填：模型名
# DeepSeek:  deepseek-chat
# 通义千问:  qwen-plus
AI_MODEL=deepseek-chat

# ------------------------------------------------------------------
# Codex 助手（形态 B/C，可选）
# 双引擎：配了下面 CODEX_* 就走 Codex（默认 Azure OpenAI Responses API），
# 没配 / 调用失败 → 自动降级到上面的 DeepSeek（本项目「双引擎铁律」）。
# 国内合规通道：CODEX_BASE_URL 填 Azure 中国区终结点（需企业/学校主体申请）。
# ------------------------------------------------------------------
# CODEX_API_KEY=你的Azure_OpenAI密钥或OpenAI密钥
# CODEX_BASE_URL=https://你的资源名.openai.azure.com/openai/v1   # Azure 中国区
# CODEX_MODEL=gpt-5-codex                                          # 你的 Azure 部署名
# CODEX_WIRE_API=responses                                        # responses(Azure Codex) | chat(OpenAI 直连)

# 选填：服务端口
PORT=3000

# ------------------------------------------------------------------
# 语音转写（上传视频/音频时用）
# 两条通道二选一，都配了就按下面的优先级自动挑。
# ------------------------------------------------------------------

# 【通道 B｜云端 Whisper】推荐：配置即用，不需要下载上 GB 的模型文件
# 只要填了下面任意一个 Key，云端通道就自动启用
WHISPER_API_KEY=sk-在这里填你的音频转写密钥

# 接口地址（OpenAI 兼容的音频接口）
# OpenAI:      https://api.openai.com/v1
# 硅基流动:     https://api.siliconflow.cn/v1
# Groq:        https://api.groq.com/openai/v1
WHISPER_BASE_URL=https://api.siliconflow.cn/v1

# 模型名（各家不同，务必按上面的 Base URL 配套填写）
# OpenAI:      whisper-1
# 硅基流动:     FunAudioLLM/SenseVoiceSmall
# Groq:        whisper-large-v3
WHISPER_MODEL=FunAudioLLM/SenseVoiceSmall

# 【通道 A｜本地 faster-whisper】离线可用，但需先下载模型文件
# TRANSCRIBE_MODE=local   强制只走本地
# TRANSCRIBE_MODE=cloud   强制只走云端
# TRANSCRIBE_MODE=auto    自动：优先本地，本地不可用则回落到云端（默认）
# TRANSCRIBE_MODE=auto

# PYTHON_PATH=D:/Tools/jiangtai-whisper/venv/Scripts/python.exe

# ------------------------------------------------------------------
# 安全红线：
# 1. 不要把 .env 提交进 Git（项目根目录请自建 .gitignore 写入 .env）
# 2. 任何密钥都不要加 NEXT_PUBLIC_ 之类的前缀 —— 那会把它下发到浏览器
# 3. 没配 Key 也不会崩：程序会自动降级为本地规则引擎（演示模式）

# ------------------------------------------------------------------
# 安全加固（2026-10-23 新增，均可选）
# ------------------------------------------------------------------

# 接口网关 sharecode：与线上页面网关一致的码。留空=不启用（本地开发兼容）；
# 部署上线时务必填上与页面网关相同的码，否则会拦截所有前端 API 调用。
# 注：该码前端可见，属"混淆式"边界，主要防止绕过 CDN 网关直刷 API 产生账单。
# SHARECODE=2WZXYSXJ6D

# 生产环境用具体域名收拢 CORS（留空=*，仅本地调试）
# ALLOWED_ORIGIN=https://jiangtai-survival.app.workbuddy.host

# 上传上限（MB，默认 50）
# MAX_UPLOAD_MB=50

# 单条讲稿字符上限（默认 20000，遏制 LLM 成本）
# TRANSCRIPT_MAX_CHARS=20000

# 限流：每客户端 IP 在窗口内的请求数（默认 60 秒 / 30 次）
# RATE_WINDOW_MS=60000
# RATE_MAX_PER_IP=30

# 全局并发闸：同时进行的昂贵请求（LLM/转写）上限（默认 8）
# GLOBAL_CONCURRENCY=8

# ------------------------------------------------------------------
# 每日模型调用上限（次/天）。0 = 不限制。
# 建议线上设为 300：即使密钥外流，单日损失也有硬上限。
# ------------------------------------------------------------------
DAILY_LLM_QUOTA=500
