{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "讲台求生 · 美术资产包",
  "version": "2026-10-30",
  "note": "哑光纸感 / 低饱和。改配色时同步更新 masters 与 classroom 里的源文件，再跑 npm run assets:students。",
  "color": {
    "classroom": {
      "wall": { "$type": "color", "$value": "#f5f0e6", "$description": "墙面纸白（浅端）" },
      "wallDeep": { "$type": "color", "$value": "#e4dccb", "$description": "墙面纸白（深端，靠近地板）" },
      "boardLight": { "$type": "color", "$value": "#396055", "$description": "黑板中心高光" },
      "boardDeep": { "$type": "color", "$value": "#27433b", "$description": "黑板边缘" },
      "boardFrame": { "$type": "color", "$value": "#cdb491", "$description": "黑板木框" },
      "boardFrameDeep": { "$type": "color", "$value": "#a98b66", "$description": "木框暗部" },
      "chalkTray": { "$type": "color", "$value": "#c3a87f", "$description": "粉笔槽" },
      "chalk": { "$type": "color", "$value": "#f6f2e7", "$description": "粉笔" },
      "floor": { "$type": "color", "$value": "#ddd3bf", "$description": "地板（近端）" },
      "floorDeep": { "$type": "color", "$value": "#cdbfa4", "$description": "地板（远端）" },
      "lightShaft": { "$type": "color", "$value": "#fffaf0", "$description": "天光" }
    },
    "desk": {
      "top": { "$type": "color", "$value": "#d9c3a1", "$description": "课桌台面" },
      "topDeep": { "$type": "color", "$value": "#b99c72", "$description": "台面暗部" },
      "front": { "$type": "color", "$value": "#bfa17a", "$description": "前挡板" },
      "frontDeep": { "$type": "color", "$value": "#a1845f", "$description": "前挡板暗部" },
      "seam": { "$type": "color", "$value": "#876d4c", "$description": "桌与桌接缝" },
      "bookWarm": { "$type": "color", "$value": "#a8705e", "$description": "课本封面（暖）" },
      "bookCool": { "$type": "color", "$value": "#6f7e72", "$description": "课本封面（冷）" },
      "pages": { "$type": "color", "$value": "#efe6d3", "$description": "书口" }
    },
    "ui": {
      "nameCard": { "$type": "color", "$value": "#faf6ed", "$description": "名牌纸片" },
      "nameCardBorder": { "$type": "color", "$value": "#968264", "$description": "名牌描边" },
      "nameCardText": { "$type": "color", "$value": "#3d3327", "$description": "名牌文字" },
      "ink": { "$type": "color", "$value": "#3d3327", "$description": "通用墨色" },
      "paper": { "$type": "color", "$value": "#f6f2e8", "$description": "页面纸底" }
    },
    "characters": {
      "girlKnit": { "$type": "color", "$value": "#6f7e70", "$description": "小皮 · 灰绿针织" },
      "girlCollar": { "$type": "color", "$value": "#e9e5d6", "$description": "小皮 · 暖白翻领" },
      "girlSkin": { "$type": "color", "$value": "#ead8c7", "$description": "小皮 · 皮肤" },
      "girlHair": { "$type": "color", "$value": "#76675a", "$description": "小皮 · 烟棕发" },
      "boySkin": { "$type": "color", "$value": "#e0bea1", "$description": "小霸 · 皮肤" },
      "boyHair": { "$type": "color", "$value": "#36362d", "$description": "小霸 · 黑发" },
      "boyShirt": { "$type": "color", "$value": "#e9e6d9", "$description": "小霸 · 白校服" },
      "mascotBody": { "$type": "color", "$value": "#ffe674", "$description": "小走 · 身体黄" },
      "mascotDeep": { "$type": "color", "$value": "#a6741f", "$description": "小走 · 暗部黄" },
      "mascotShirt": { "$type": "color", "$value": "#dde0d1", "$description": "小走 · 白校服" }
    },
    "semantic": {
      "good": { "$type": "color", "$value": "#16a34a", "$description": "专注度 ≥ 70" },
      "warn": { "$type": "color", "$value": "#f59e0b", "$description": "专注度 45~69" },
      "bad": { "$type": "color", "$value": "#dc2626", "$description": "专注度 < 45" },
      "unknown": { "$type": "color", "$value": "#94a3b8", "$description": "分数未提供" }
    }
  },
  "size": {
    "portraitViewBox": {
      "geek": { "$type": "dimension", "$value": "620px 800px" },
      "naughty": { "$type": "dimension", "$value": "600px 760px" },
      "drift": { "$type": "dimension", "$value": "600px 740px" }
    },
    "classroomViewBox": { "$type": "dimension", "$value": "2400px 800px" },
    "floorLineRatio": { "$type": "dimension", "$value": 0.845, "$description": "地板线 / 画布高度，与立绘脚底对齐" }
  }
}
